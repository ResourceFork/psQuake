# CMake build trees (cmake -S . -B build, build-xcode, build-release, ...)
build*/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
CTestTestfile.cmake
Testing/
cmake_install.cmake
compile_commands.json

# Local scratch work (never committed)
scratch/

# Compiler and debugger outputs
*.o
*.a
*.dylib
*.dSYM/
*.dSYM.zip

# Logs
*.log

# User-supplied game data (never committed)
id1/*.pak

# Editors
.vscode/
.idea/
*.swp
*~
xcuserdata/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# LibreQuake game data fetched by tools/fetch-librequake.sh (never committed)
data/

# Vendored engine libraries (third_party/quakespasm/MacOSX/codecs) are tracked
!third_party/quakespasm/MacOSX/codecs/lib/*.dylib

# Python bytecode
__pycache__/
